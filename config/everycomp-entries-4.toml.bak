#Disables specific entries
[entries]

		[entries.stone_type.create]
			small_brick_wall = false
			cut_wall = false
			small_bricks = false
			cut_brick_slab = false
			polished_cut_slab = false
			small_brick_stairs = false
			cut_bricks = false
			cut = false
			polished_cut = false
			small_brick_slab = false
			layered = false
			polished_cut_stairs = false
			cut_brick_wall = false
			pillar = false
			cut_stairs = false
			cut_brick_stairs = false
			polished_cut_wall = false
			cut_slab = false

		[entries.stone_type.quark]
			polished_vertical_slab = true
			pillar = true
			vertical_slab = true

		[entries.mud_type.quark]
			carved_bricks = true
			pillar = true
			brick_lattice = true

		[entries.wood_type.quark]
			vertical_planks = true
			post = true
			chest = true
			stripped_post = true
			ladder = true
			trapped_chest = true
			bookshelf = true
			hollow_log = true
			vertical_slab = true

		[entries.wood_type.create]
			window_pane = true
			window = true

		[entries.wood_type.farmersdelight]
			cabinet = true

		[entries.leaves_type.quark]
			hedge = true
			leaf_carpet = true
